# Optional settings for a site OpenShift deployment.
# Copy to a private shell/session or CI variable store; do not commit secrets.

# The no-argument launcher defaults to real CPU Jobs with pinned images from
# avery91-dev. Only set these when overriding that deployment.
# CONDITAR_RUNTIME=openshift_job
# CONDITAR_OPENSHIFT_SUBMIT=true
# CONDITAR_GUI_IMAGE=registry.example.edu/site/conditar-gui:<version>
# CONDITAR_DOCKER_IMAGE=registry.example.edu/site/conditar:<version>
# DIFFSMOL_DOCKER_IMAGE=registry.example.edu/site/diffsmol:<version>
CONDITAR_OPENSHIFT_STORAGE=10Gi
CONDITAR_OPENSHIFT_ROUTE_HOST=

# Kubernetes Job settings. These are used for submitted OpenShift Jobs and are
# also written into generated manifest artifacts when submission is disabled.
CONDITAR_OPENSHIFT_PVC=conditar-gui-jobs
CONDITAR_OPENSHIFT_JOB_MOUNT=/data/jobs
CONDITAR_OPENSHIFT_NAMESPACE=
CONDITAR_OPENSHIFT_SERVICE_ACCOUNT=
CONDITAR_OPENSHIFT_DEVICE=cpu
CONDITAR_OPENSHIFT_GPU_RESOURCE=nvidia.com/gpu
CONDITAR_OPENSHIFT_GPU_COUNT=0
CONDITAR_OPENSHIFT_CPU_REQUEST=500m
CONDITAR_OPENSHIFT_MEMORY_REQUEST=4Gi
CONDITAR_OPENSHIFT_MEMORY_LIMIT=8Gi
CONDITAR_OPENSHIFT_IMAGE_PULL_POLICY=IfNotPresent
