FROM mambaorg/micromamba:1.5.8

ARG CONDITAR_GUI_TOOL_CHEST=full

ENV HOST=0.0.0.0 \
    PORT=8080 \
    CONDITAR_JOB_ROOT=/data/jobs \
    CONDITAR_RUNTIME=openshift_mock \
    MAMBA_DOCKERFILE_ACTIVATE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/conditar-gui

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        make \
        ruby \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

USER $MAMBA_USER
COPY --chown=$MAMBA_USER:$MAMBA_USER environment.yml /tmp/environment.yml
RUN if [ "$CONDITAR_GUI_TOOL_CHEST" = "minimal" ]; then \
        micromamba create -y -n conditar-gui-dev -c conda-forge python=3.11; \
    else \
        micromamba create -y -f /tmp/environment.yml; \
    fi \
    && micromamba clean --all --yes

ENV CONDA_DEFAULT_ENV=conditar-gui-dev \
    PATH=/opt/conda/envs/conditar-gui-dev/bin:$PATH

USER root
RUN if [ "$CONDITAR_GUI_TOOL_CHEST" = "full" ]; then \
        git clone --depth 1 https://github.com/IanAWatson/Lilly-Medchem-Rules.git /opt/conditar-gui/.tool_chest/Lilly-Medchem-Rules \
        && make -C /opt/conditar-gui/.tool_chest/Lilly-Medchem-Rules; \
    fi \
    && mkdir -p /data/jobs \
    && chown -R $MAMBA_USER:0 /data /opt/conda /opt/conditar-gui \
    && chmod -R g=u /data /opt/conda /opt/conditar-gui

USER $MAMBA_USER
COPY --chown=$MAMBA_USER:0 . /opt/conditar-gui

USER root
RUN chmod -R g=u /opt/conditar-gui

USER $MAMBA_USER

EXPOSE 8080

CMD ["python", "serve.py"]
